<Window x:Class="LycRomanise.UI.LyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LycRomanise.UI"
        Title="Lyrics - LycRomanise" Width="1180" Height="760" MinWidth="520" MinHeight="420"
        Background="#0B0B10" Icon="/Assets/lyrics-overlay.ico" ThemeMode="Dark">
    <Grid x:Name="Root" ClipToBounds="True">
        <Grid x:Name="BackdropHost" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="DriftScale" ScaleX="1.5" ScaleY="1.5"/>
                    <RotateTransform x:Name="DriftRotate" Angle="0"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <!-- The cache sits above the blur, so the drift only resamples an already blurred bitmap
                 instead of running the 110 px blur again every frame. -->
            <Grid>
                <Grid.CacheMode>
                    <BitmapCache RenderAtScale="0.35"/>
                </Grid.CacheMode>
                <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.85" RenderOptions.BitmapScalingMode="Linear">
                    <Image.Effect>
                        <BlurEffect Radius="110" KernelType="Gaussian" RenderingBias="Performance"/>
                    </Image.Effect>
                </Image>
            </Grid>
        </Grid>
        <Rectangle x:Name="Fallback">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF3B1F4F" Offset="0"/>
                    <GradientStop Color="#FF7A1F4F" Offset="0.55"/>
                    <GradientStop Color="#FF2A1830" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#8C000000" Offset="0"/>
                    <GradientStop Color="#B8000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle x:Name="BlackBg" Fill="#FF050506" Visibility="Collapsed"/>

        <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="0.82*"/>
                <ColumnDefinition Width="1.18*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="NowPanel" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40,30,20,30" MaxWidth="420">
                <StackPanel>
                    <Border x:Name="CoverCard" CornerRadius="14" Width="360" Height="360" Background="#33FFFFFF" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.45" Color="Black" RenderingBias="Performance"/>
                        </Border.Effect>
                        <Grid>
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="80" Foreground="#55FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border CornerRadius="14">
                                <Border.Background>
                                    <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="TitleText" Margin="0,26,0,0" FontSize="24" FontWeight="Bold" Foreground="White"
                               TextTrimming="CharacterEllipsis" Width="360"/>
                    <TextBlock x:Name="ArtistText" Margin="0,2,0,0" FontSize="18" Foreground="#B3FFFFFF"
                               TextTrimming="CharacterEllipsis" Width="360"/>

                    <Grid Width="360" Margin="0,18,0,0">
                        <Border x:Name="Track" Height="6" CornerRadius="3" Background="#40FFFFFF" Cursor="Hand"
                                MouseLeftButtonUp="Track_Click"/>
                        <Border x:Name="Fill" Height="6" CornerRadius="3" Background="#E6FFFFFF" HorizontalAlignment="Left" Width="0" IsHitTestVisible="False"/>
                    </Grid>
                    <Grid Width="360" Margin="0,6,0,0">
                        <TextBlock x:Name="ElapsedText" FontSize="12" Foreground="#99FFFFFF"/>
                        <TextBlock x:Name="RemainText" FontSize="12" Foreground="#99FFFFFF" HorizontalAlignment="Right"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Style="{StaticResource PlayerButton}" Click="Prev_Click" Content="&#xE892;" ToolTip="Previous"/>
                        <Button x:Name="PlayBtn" Style="{StaticResource PlayerButton}" Click="Play_Click" Content="&#xE769;" FontSize="30" Width="64" Height="64" ToolTip="Play / pause"/>
                        <Button Style="{StaticResource PlayerButton}" Click="Next_Click" Content="&#xE893;" ToolTip="Next"/>
                    </StackPanel>

                    <TextBlock x:Name="CreditText" Margin="0,18,0,0" FontSize="11" Foreground="#80FFFFFF" TextWrapping="Wrap" Width="360"/>
                </StackPanel>
            </Grid>

            <ui:LyricsPageView x:Name="Page" Grid.Column="1" Margin="0,0,10,0"/>
        </Grid>

        <StackPanel x:Name="Tools" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,18,0">
            <Button Style="{StaticResource OverlayButton}" Click="Smaller_Click" Content="&#xE8E7;" ToolTip="Smaller text"/>
            <Button Style="{StaticResource OverlayButton}" Click="Bigger_Click" Content="&#xE8E8;" ToolTip="Bigger text"/>
            <Button Style="{StaticResource OverlayButton}" Click="Copy_Click" Content="&#xE8C8;" ToolTip="Copy the lyrics"/>
            <Button Style="{StaticResource OverlayButton}" Click="Choose_Click" Content="&#xE8FD;" ToolTip="Choose lyrics for this song"/>
            <Button x:Name="PinBtn" Style="{StaticResource OverlayButton}" Click="Pin_Click" Content="&#xE718;" ToolTip="Keep on top"/>
            <Button Style="{StaticResource OverlayButton}" Click="Panel_Click" Content="&#xE89F;" ToolTip="Show or hide the player"/>
            <Button x:Name="GearBtn" Style="{StaticResource OverlayButton}" Click="Gear_Click" Content="&#xE713;" ToolTip="Settings for this window (S)"/>
        </StackPanel>

        <Border x:Name="SettingsPanel" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="340" Margin="0,58,16,16"
                CornerRadius="14" Background="#F00C0C0E" BorderBrush="#22FFFFFF" BorderThickness="1" Visibility="Collapsed">
            <Border.RenderTransform><TranslateTransform x:Name="PanelSlide" X="0"/></Border.RenderTransform>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14,18,16">
                <StackPanel x:Name="PanelBody"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
