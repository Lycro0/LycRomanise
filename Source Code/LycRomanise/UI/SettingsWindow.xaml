<Window x:Class="LycRomanise.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LycRomanise Settings" Width="1020" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Icon="/Assets/lyrics-overlay.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Grid.Column="0" Margin="10,14,6,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,18">
                <Border Width="34" Height="34" CornerRadius="9">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFE14D" Offset="0"/>
                            <GradientStop Color="#FF3D9A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="LycRomanise" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock x:Name="VersionText" Text="Modern" FontSize="11" Opacity="0.6"/>
                </StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom">
                <!-- The full lyrics window, one click away from any page. -->
                <Button x:Name="LyricsBar" Click="LyricsBar_Click" Margin="2,0,2,10" Padding="0" Cursor="Hand"
                        HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Card" CornerRadius="10" Padding="14,12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFFF3D9A" Offset="0"/>
                                        <GradientStop Color="#FF8A3DFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8BC;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Full lyrics" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock x:Name="LyricsBarSong" Text="Open the lyrics screen" Foreground="#D9FFFFFF" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource Icons}" Foreground="White" VerticalAlignment="Center" FontSize="12"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Opacity" Value="0.88"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Card" Property="Opacity" Value="0.75"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Border x:Name="UpdateBar" Visibility="Collapsed" CornerRadius="8" Margin="2,0,2,10" Padding="12,8"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" Cursor="Hand" MouseLeftButtonUp="UpdateBar_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="UpdateBarText" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="SavedText" Text="Changes apply instantly" FontSize="11" Opacity="0.55" Margin="12,0,0,0"/>
            </StackPanel>
            <StackPanel x:Name="Nav"/>
        </DockPanel>

        <!-- Page -->
        <Border Grid.Column="1" CornerRadius="8,0,0,0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="36,28,36,28">
                <ContentControl x:Name="PageHost" MaxWidth="900"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
